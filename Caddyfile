# Caddyfile for Checklist Garden
#
# Domains are hardcoded here (single production domain). The deploy workflow
# copies this file verbatim to /etc/caddy/Caddyfile and reloads caddy.

checklist.garden, www.checklist.garden {
    encode gzip

    request_body {
        max_size 20MB
    }

    reverse_proxy 127.0.0.1:8000 {
        transport http {
            read_timeout 3600s
            write_timeout 3600s
        }
    }
}
