[Unit]
Description=Checklist Garden
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/workspace/checklist-garden
EnvironmentFile=/workspace/checklist-garden/.env
ExecStart=/root/agent/.venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
